{
  "expo": {
    "name": "AutoHelp",
    "slug": "AUTO-HELP-GH",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stephenj.autohelp"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.stephenj.autohelp",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "autohelpgh"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "scheme": "autohelpgh",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "android": {
            "imageWidth": 288
          },
          "ios": {
            "imageWidth": 440
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c30eccc0-075b-4ab4-a7b8-7641fdd5e6be"
      }
    },
    "owner": "stephenj2"
  }
}
